    "\n",
    "from lifelines import KaplanMeierFitter\n",
    "\n",
    "# Create Kaplan-Meier estimator\n",
    "kmf = KaplanMeierFitter()\n",
    "\n",
    "# Fit the model\n",
    "kmf.fit(\n",
    "    durations=df['tenure'],\n",
    "    event_observed=df['Churn'].eq('Yes'),\n",
    "    label='Customer Retention'\n",
    ")\n",
    "\n",
    "# Display retention estimates\n",
    "display(kmf.survival_function_.head(15))\n"
   ]
  },
