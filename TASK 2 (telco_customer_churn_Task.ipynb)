    "\n",
    "# Group customers by tenure and calculate churn\n",
    "\n",
    "tenure_churn = df.groupby('TenureGroup', observed=False).agg(\n",
    "    Total_Customers=('Churn', 'count'),\n",
    "    Churned_Customers=('Churn', lambda x: (x == 'Yes').sum())\n",
    ")\n",
    "\n",
    "# Calculate churn probability and churn rate\n",
    "tenure_churn['Churn_Rate'] = (\n",
    "    tenure_churn['Churned_Customers'] /\n",
    "    tenure_churn['Total_Customers']\n",
    ") * 100\n",
    "\n",
    "# Calculate retention rate\n",
    "tenure_churn['Retention_Rate'] = 100 - tenure_churn['Churn_Rate']\n",
    "\n",
    "display(tenure_churn.round(2))\n"
   ]
  },
